static func level_count() -> int:
	return LEVELS.size()

static func clone_map(level_idx: int) -> Array:
	var src: Array = LEVELS[level_idx]["map"]
	var out: Array = []
	for row in src:
		var r: Array = []
		for v in row:
			r.append(int(v))
		out.append(r)
	return out

static func find_player(map_data: Array) -> Vector2i:
	for y in map_data.size():
		var row: Array = map_data[y]
		for x in row.size():
			var t: int = int(row[x])
			if t == 4 or t == 6:
				return Vector2i(x, y)
	return Vector2i(-1, -1)

static func is_target(map_data: Array, pos: Vector2i) -> bool:
	if pos.y < 0 or pos.y >= map_data.size():
		return false
	var row: Array = map_data[pos.y]
	if pos.x < 0 or pos.x >= row.size():
		return false
	var t: int = int(row[pos.x])
	return t == 3 or t == 5 or t == 6

static func is_box(map_data: Array, pos: Vector2i) -> bool:
	if pos.y < 0 or pos.y >= map_data.size():
		return false
	var row: Array = map_data[pos.y]
	if pos.x < 0 or pos.x >= row.size():
		return false
	var t: int = int(row[pos.x])
	return t == 2 or t == 5

static func tile_at(map_data: Array, pos: Vector2i) -> int:
	var row: Array = map_data[pos.y]
	return int(row[pos.x])

static func set_tile(map_data: Array, pos: Vector2i, tile: int) -> void:
	var row: Array = map_data[pos.y]
	row[pos.x] = tile

static func all_boxes_on_target(map_data: Array) -> bool:
	for y in map_data.size():
		var row: Array = map_data[y]
		for x in row.size():
			if int(row[x]) == 2:
				return false
	return true

static func try_move(map_data: Array, player: Vector2i, dir: Vector2i) -> Dictionary:
	var next := player + dir
	if next.y < 0 or next.y >= map_data.size():
		return {"ok": false}
	var row_next: Array = map_data[next.y]
	if next.x < 0 or next.x >= row_next.size():
		return {"ok": false}
	var next_tile: int = int(row_next[next.x])
	if next_tile == 1:
		return {"ok": false}
	var new_map: Array = clone_map_from(map_data)
	var new_player := player
	if is_box(map_data, next):
		var box_next := next + dir
		if box_next.y < 0 or box_next.y >= new_map.size():
			return {"ok": false}
		var row_box: Array = new_map[box_next.y]
		if box_next.x < 0 or box_next.x >= row_box.size():
			return {"ok": false}
		var box_tile: int = int(row_box[box_next.x])
		if box_tile == 1 or is_box(new_map, box_next):
			return {"ok": false}
		var box_from_target := is_target(new_map, next)
		var box_to_target := is_target(new_map, box_next)
		set_tile(new_map, next, 3 if box_from_target else 0)
		set_tile(new_map, box_next, 5 if box_to_target else 2)
	var player_from_target := is_target(new_map, player)
	var player_to_target := is_target(new_map, next)
	set_tile(new_map, player, 3 if player_from_target else 0)
	set_tile(new_map, next, 6 if player_to_target else 4)
	new_player = next
	return {"ok": true, "map": new_map, "player": new_player}

static func clone_map_from(src: Array) -> Array:
	var out: Array = []
	for row in src:
		var r: Array = []
		for v in row:
			r.append(int(v))
		out.append(r)
	return out
